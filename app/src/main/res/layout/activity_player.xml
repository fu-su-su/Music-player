<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 第1层：全屏图片背景 -->
    <com.musicplayer.app.ui.player.GradientMaskImageView
        android:id="@+id/coverImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="封面"
        android:scaleType="centerCrop" />

    <!-- 第2层：内容叠加层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 0-3：顶部图片完整显示区（weight=3，30%） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- 3-4：歌曲信息（weight=1，10%） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artistTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/text_large" />
        </LinearLayout>

        <!-- 4-6：中部空白区 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- 6-8：歌词区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lyricRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </FrameLayout>

        <!-- 8-9：底部空白区 -->
        <View
            android:id="@+id/bottomSpacerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 9-10：底部控制区（纯黑色） -->
        <LinearLayout
            android:id="@+id/controlsPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF000000"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <!-- 进度条行：时间 + SeekBar + 收起按钮（右上角） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/text_xs" />

                <SeekBar
                    android:id="@+id/progressSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#80FFFFFF"
                    android:progressTint="#FFFFFFFF"
                    android:splitTrack="false"
                    android:thumbTint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/totalTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/text_xs" />

                <ImageButton
                    android:id="@+id/collapseButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="收起控件"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_arrow_down"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>

            <!-- 5个控制按钮均匀排列：播放模式 | 上一首 | 暂停 | 下一首 | 歌曲详情 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/loopModeButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="循环模式"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_loop_order"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/previousButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/previous"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_previous"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/play"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_play"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/next"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_next"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/songDetailsButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="歌曲详情"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_menu_lines"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 纯净模式右下角上箭头 -->
    <ImageButton
        android:id="@+id/expandButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="展开控件"
        android:padding="@dimen/spacing_md"
        android:scaleType="centerInside"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_arrow_up"
        app:tint="#80FFFFFF" />
</FrameLayout>
