<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE1E0DE">

    <!-- 第1层：全屏图片背景，从顶部不透明到底部透明渐变 -->
    <com.musicplayer.app.ui.player.GradientMaskImageView
        android:id="@+id/coverImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="封面"
        android:scaleType="centerCrop" />

    <!-- 第2层：内容叠加层，按 10 单位坐标布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 0-3：顶部图片完整显示区（weight=3，30%） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- 3-4：歌曲信息（weight=1，10%，垂直居中） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artistTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="@color/white"
                android:textSize="@dimen/text_large" />
        </LinearLayout>

        <!-- 4-6：中部空白区（weight=2，20%） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- 6-8：歌词区（weight=2，20%） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lyricRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </FrameLayout>

        <!-- 8-9：底部空白区（weight=1，10%，图片接近完全透明） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 9-10：底部控制区（weight=1，10%，白色25%透明） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#40FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <!-- 进度条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FF666666"
                    android:textSize="@dimen/text_xs" />

                <SeekBar
                    android:id="@+id/progressSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/progress_background"
                    android:progressTint="#FF888888"
                    android:splitTrack="false"
                    android:thumbTint="#FF888888" />

                <TextView
                    android:id="@+id/totalTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FF666666"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <!-- 控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/loopModeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:background="@null"
                    android:contentDescription="循环模式"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_loop_order"
                    app:tint="#FF888888" />

                <ImageButton
                    android:id="@+id/previousButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@null"
                    android:contentDescription="@string/previous"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@android:drawable/ic_media_previous"
                    app:tint="#FF888888" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@null"
                    android:contentDescription="@string/play"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@android:drawable/ic_media_play"
                    app:tint="#FF888888" />

                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@null"
                    android:contentDescription="@string/next"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@android:drawable/ic_media_next"
                    app:tint="#FF888888" />

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@null"
                    android:contentDescription="返回"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerInside"
                    app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FF888888" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
